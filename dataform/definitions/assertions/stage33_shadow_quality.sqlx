    OR `AG_VF_E_05` NOT IN (0, 1) OR `AG_VF_E_05` IS NULL
    OR `AG_VF_E_06` NOT IN (0, 1) OR `AG_VF_E_06` IS NULL
    OR `AG_VF_E_07` NOT IN (0, 1) OR `AG_VF_E_07` IS NULL
    OR `AG_VF_E_08` NOT IN (0, 1) OR `AG_VF_E_08` IS NULL
    OR `AG_VF_E_09` NOT IN (0, 1) OR `AG_VF_E_09` IS NULL
  )
  FROM candidate
  HAVING COUNTIF(
    `C3P223_1_1` NOT IN (0, 1) OR `C3P223_1_1` IS NULL
    OR `C3P223_2_1` NOT IN (0, 1) OR `C3P223_2_1` IS NULL
    OR `C3P223_3_1` NOT IN (0, 1) OR `C3P223_3_1` IS NULL
    OR `C3P223_4_1` NOT IN (0, 1) OR `C3P223_4_1` IS NULL
