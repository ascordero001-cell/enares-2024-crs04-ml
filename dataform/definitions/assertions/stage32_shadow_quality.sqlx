    OR `AG_VF_H_05` NOT IN (0, 1) OR `AG_VF_H_05` IS NULL
    OR `AG_VF_H_06` NOT IN (0, 1) OR `AG_VF_H_06` IS NULL
    OR `AG_VF_H_07` NOT IN (0, 1) OR `AG_VF_H_07` IS NULL
    OR `AG_VF_H_08` NOT IN (0, 1) OR `AG_VF_H_08` IS NULL
