    household.`VF_HOGAR` AS `VF_HOGAR`,
    school.`VP_ESCUELA` AS `VP_ESCUELA`,
    school.`VF_ESCUELA` AS `VF_ESCUELA`,
    sexual.`VS_12M` AS `VS_12M`
  FROM ${ref("cleaned_crs04_merged_adolescents_v0_5")} AS cleaned
  LEFT JOIN ${ref("analytical_crs04_stage32_v0_5")} AS household
    USING (ID, COLEGIAL_ID)
  LEFT JOIN ${ref("analytical_crs04_stage33_v0_5")} AS school
    USING (ID, COLEGIAL_ID)
  LEFT JOIN ${ref("analytical_crs04_stage34_v0_5")} AS sexual
    USING (ID, COLEGIAL_ID)
),

block_01_36_ayuda_componentes AS (
  SELECT
    *,
    CASE WHEN C3P209 = 1 THEN 1 WHEN C3P209 = 2 THEN 0 END AS `busco_ayuda_hogar`,
    CASE WHEN C3P211 = 1 THEN 1 WHEN C3P211 = 2 THEN 0 END AS `recibio_ayuda_hogar`,
    CASE WHEN C3P214 = 1 THEN 1 WHEN C3P214 = 2 THEN 0 END AS `apoyo_institucional_hogar`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_1` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_madre`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_2` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_padre`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_3` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_madrastra`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_4` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_padrastro`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_5` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_hermana`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_6` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_hermano`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_7` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_abuela`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_8` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_abuelo`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_9` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_tia`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_10` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_tio`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_11` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_otro_pariente`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_1` = 1 OR `C3P210_2` = 1 OR `C3P210_3` = 1 OR `C3P210_4` = 1 OR `C3P210_5` = 1 OR `C3P210_6` = 1 OR `C3P210_7` = 1 OR `C3P210_8` = 1 OR `C3P210_9` = 1 OR `C3P210_10` = 1 OR `C3P210_11` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_familiar`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_12` = 1 OR `C3P210_13` = 1 OR `C3P210_14` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_car`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_15` = 1 OR `C3P210_16` = 1 OR `C3P210_17` = 1 OR `C3P210_18` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_escolar_adulto`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_19` = 1 OR `C3P210_20` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_pares_amigos`,
    CASE WHEN C3P209 IN (1,2) AND (`C3P210_21` = 1) THEN 1 WHEN C3P209 IN (1,2) THEN 0 END AS `ayuda_hogar_otro`,
    CASE WHEN C3P212_1 = 1 THEN 1 ELSE 0 END AS `ayuda_hogar_consuelo`,
    CASE WHEN C3P212_2 = 1 THEN 1 ELSE 0 END AS `ayuda_hogar_consejo`,
    CASE WHEN C3P212_3 = 1 THEN 1 ELSE 0 END AS `ayuda_hogar_hablo_familia`,
    CASE WHEN C3P212_4 = 1 THEN 1 ELSE 0 END AS `ayuda_hogar_llamo_atencion`,
    CASE WHEN C3P212_5 = 1 THEN 1 ELSE 0 END AS `ayuda_hogar_respuesta_agresion`,
    CASE WHEN C3P212_6 = 1 THEN 1 ELSE 0 END AS `ayuda_hogar_otro_tipo`,
    CASE WHEN C3P236 = 1 THEN 1 WHEN C3P236 = 2 THEN 0 END AS `busco_ayuda_escuela`,
    CASE WHEN C3P238 = 1 THEN 1 WHEN C3P238 = 2 THEN 0 END AS `recibio_ayuda_escuela`,
    CASE WHEN C3P241 = 1 THEN 1 WHEN C3P241 = 2 THEN 0 END AS `apoyo_institucional_escuela`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_1` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_madre`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_2` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_padre`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_3` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_madrastra`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_4` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_padrastro`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_5` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_hermana`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_6` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_hermano`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_7` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_abuela`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_8` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_abuelo`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_9` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_tia`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_10` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_tio`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_11` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_otro_pariente`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_1` = 1 OR `C3P237_2` = 1 OR `C3P237_3` = 1 OR `C3P237_4` = 1 OR `C3P237_5` = 1 OR `C3P237_6` = 1 OR `C3P237_7` = 1 OR `C3P237_8` = 1 OR `C3P237_9` = 1 OR `C3P237_10` = 1 OR `C3P237_11` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_familiar`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_12` = 1 OR `C3P237_13` = 1 OR `C3P237_14` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_car`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_15` = 1 OR `C3P237_16` = 1 OR `C3P237_17` = 1 OR `C3P237_18` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_escolar_adulto`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_19` = 1 OR `C3P237_20` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_pares_amigos`,
    CASE WHEN C3P236 IN (1,2) AND (`C3P237_21` = 1) THEN 1 WHEN C3P236 IN (1,2) THEN 0 END AS `ayuda_escuela_otro`,
    CASE WHEN C3P239_1 = 1 THEN 1 ELSE 0 END AS `ayuda_escuela_consuelo`,
    CASE WHEN C3P239_2 = 1 THEN 1 ELSE 0 END AS `ayuda_escuela_aviso_docente`,
    CASE WHEN C3P239_3 = 1 THEN 1 ELSE 0 END AS `ayuda_escuela_hablo_agresor`,
    CASE WHEN C3P239_4 = 1 THEN 1 ELSE 0 END AS `ayuda_escuela_llamo_atencion`,
    CASE WHEN C3P239_5 = 1 THEN 1 ELSE 0 END AS `ayuda_escuela_hablo_director`,
    CASE WHEN C3P239_6 = 1 THEN 1 ELSE 0 END AS `ayuda_escuela_hablo_padres_agresor`,
    CASE WHEN C3P239_7 = 1 THEN 1 ELSE 0 END AS `ayuda_escuela_consejo`,
    CASE WHEN C3P239_8 = 1 THEN 1 ELSE 0 END AS `ayuda_escuela_otro_tipo`
  FROM base
),

block_02_36_ayuda_derivados AS (
  SELECT
    *,
    CASE WHEN (VP_HOGAR = 1 OR VF_HOGAR = 1) AND C3P211 = 3 THEN NULL WHEN VP_HOGAR = 1 OR VF_HOGAR = 1 THEN CASE WHEN C3P211 = 1 THEN 1 ELSE 0 END END AS `recibio_ayuda_hogar_victimas`,
    CASE WHEN busco_ayuda_hogar = 1 AND recibio_ayuda_hogar = 0 THEN 1 WHEN busco_ayuda_hogar = 1 AND recibio_ayuda_hogar = 1 THEN 0 END AS `brecha_ayuda_hogar`,
    CASE WHEN (VP_HOGAR = 1 OR VF_HOGAR = 1) AND apoyo_institucional_hogar = 0 THEN 1 WHEN (VP_HOGAR = 1 OR VF_HOGAR = 1) AND apoyo_institucional_hogar = 1 THEN 0 END AS `brecha_institucional_hogar`,
    CASE WHEN (VP_ESCUELA = 1 OR VF_ESCUELA = 1) AND C3P238 = 3 THEN NULL WHEN VP_ESCUELA = 1 OR VF_ESCUELA = 1 THEN CASE WHEN C3P238 = 1 THEN 1 ELSE 0 END END AS `recibio_ayuda_escuela_victimas`,
    CASE WHEN busco_ayuda_escuela = 1 AND recibio_ayuda_escuela = 0 THEN 1 WHEN busco_ayuda_escuela = 1 AND recibio_ayuda_escuela = 1 THEN 0 END AS `brecha_ayuda_escuela`,
    CASE WHEN (VP_ESCUELA = 1 OR VF_ESCUELA = 1) AND apoyo_institucional_escuela = 0 THEN 1 WHEN (VP_ESCUELA = 1 OR VF_ESCUELA = 1) AND apoyo_institucional_escuela = 1 THEN 0 END AS `brecha_institucional_escuela`
  FROM block_01_36_ayuda_componentes
),

block_03_36_ayuda_vs_componentes AS (
  SELECT
    *,
    CASE WHEN C4P252 = 1 THEN 1 WHEN C4P252 = 2 THEN 0 END AS `busco_ayuda_vs`,
    CASE WHEN C4P254 = 1 THEN 1 WHEN C4P254 = 2 THEN 0 END AS `recibio_ayuda_vs`,
    CASE WHEN C4P257 = 1 THEN 1 WHEN C4P257 = 2 THEN 0 END AS `apoyo_institucional_vs`,
    CASE WHEN C4P259 = 1 THEN 1 WHEN C4P259 = 2 THEN 0 END AS `recibio_ayuda_institucional_vs`,
    CASE WHEN C3P246 = 1 THEN 1 WHEN C3P246 = 2 THEN 0 END AS `conoce_demuna`,
    CASE WHEN C3P247 = 1 THEN 1 WHEN C3P247 = 2 THEN 0 END AS `uso_demuna`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_1` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_madre`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_2` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_padre`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_3` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_madrastra`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_4` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_padrastro`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_5` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_hermana`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_6` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_hermano`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_7` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_abuela`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_8` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_abuelo`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_9` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_tia`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_10` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_tio`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_11` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_otro_pariente`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_1` = 1 OR `C4P253_2` = 1 OR `C4P253_3` = 1 OR `C4P253_4` = 1 OR `C4P253_5` = 1 OR `C4P253_6` = 1 OR `C4P253_7` = 1 OR `C4P253_8` = 1 OR `C4P253_9` = 1 OR `C4P253_10` = 1 OR `C4P253_11` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_familiar`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_12` = 1 OR `C4P253_13` = 1 OR `C4P253_14` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_car`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_15` = 1 OR `C4P253_16` = 1 OR `C4P253_17` = 1 OR `C4P253_18` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_escolar_adulto`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_19` = 1 OR `C4P253_20` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_pares_amigos`,
    CASE WHEN C4P252 IN (1,2) AND (`C4P253_21` = 1) THEN 1 WHEN C4P252 IN (1,2) THEN 0 END AS `ayuda_vs_otro`,
    CASE WHEN C4P255_1 = 1 THEN 1 ELSE 0 END AS `ayuda_vs_consejo`,
    CASE WHEN C4P255_2 = 1 THEN 1 ELSE 0 END AS `ayuda_vs_hablo_madre_padre`,
    CASE WHEN C4P255_3 = 1 THEN 1 ELSE 0 END AS `ayuda_vs_reclamo_agresor`,
    CASE WHEN C4P255_4 = 1 THEN 1 ELSE 0 END AS `ayuda_vs_aviso_autoridades`,
    CASE WHEN C4P255_5 = 1 THEN 1 ELSE 0 END AS `ayuda_vs_refugio`,
    CASE WHEN C4P255_6 = 1 THEN 1 ELSE 0 END AS `ayuda_vs_especialista`,
    CASE WHEN C4P255_7 = 1 THEN 1 ELSE 0 END AS `ayuda_vs_otro_tipo`,
    CASE WHEN C4P260_1 = 1 THEN 1 ELSE 0 END AS `ayuda_inst_vs_hablo_familia`,
    CASE WHEN C4P260_2 = 1 THEN 1 ELSE 0 END AS `ayuda_inst_vs_terapias`,
    CASE WHEN C4P260_3 = 1 THEN 1 ELSE 0 END AS `ayuda_inst_vs_llamo_atencion`,
    CASE WHEN C4P260_4 = 1 THEN 1 ELSE 0 END AS `ayuda_inst_vs_otro`
  FROM block_02_36_ayuda_derivados
),

block_04_36_ayuda_vs_derivados AS (
  SELECT
    *,
    CASE WHEN VS_12M = 1 AND C4P254 = 3 THEN NULL WHEN VS_12M = 1 THEN CASE WHEN C4P254 = 1 THEN 1 ELSE 0 END END AS `recibio_ayuda_vs_victimas`,
    CASE WHEN busco_ayuda_vs = 1 AND recibio_ayuda_vs = 0 THEN 1 WHEN busco_ayuda_vs = 1 AND recibio_ayuda_vs = 1 THEN 0 END AS `brecha_ayuda_vs`,
    CASE WHEN VS_12M = 1 AND apoyo_institucional_vs = 0 THEN 1 WHEN VS_12M = 1 AND apoyo_institucional_vs = 1 THEN 0 END AS `brecha_institucional_vs`
  FROM block_03_36_ayuda_vs_componentes
)

