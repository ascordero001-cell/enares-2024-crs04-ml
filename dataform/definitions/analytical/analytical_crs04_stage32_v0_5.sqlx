block_01_32_hogar_formas AS (
  SELECT
    *,
    CASE WHEN SEXO IN (1,2) AND C3P201_1 = 1 AND C3P203 = 1 AND (C3P201A_1 IN (1,2,3,4,19) OR C3P201E_1 IN (1,2,3,4,19) OR (C3P201A_1 IS NOT NULL AND C3P201A_1 NOT IN (1,2,3,4,19) AND C3P201C_1 = 1 AND C3P201D_1 = 1) OR (C3P201E_1 IS NOT NULL AND C3P201E_1 NOT IN (1,2,3,4,19) AND C3P201F_1 = 1)) THEN 1 ELSE 0 END AS `C3P201_1_1`,
    CASE WHEN SEXO IN (1,2) AND C3P201_2 = 1 AND C3P203 = 1 AND (C3P201A_2 IN (1,2,3,4,19) OR C3P201E_2 IN (1,2,3,4,19) OR (C3P201A_2 IS NOT NULL AND C3P201A_2 NOT IN (1,2,3,4,19) AND C3P201C_2 = 1 AND C3P201D_2 = 1) OR (C3P201E_2 IS NOT NULL AND C3P201E_2 NOT IN (1,2,3,4,19) AND C3P201F_2 = 1)) THEN 1 ELSE 0 END AS `C3P201_2_1`,
    CASE WHEN SEXO IN (1,2) AND C3P201_3 = 1 AND C3P203 = 1 AND (C3P201A_3 IN (1,2,3,4,19) OR C3P201E_3 IN (1,2,3,4,19) OR (C3P201A_3 IS NOT NULL AND C3P201A_3 NOT IN (1,2,3,4,19) AND C3P201C_3 = 1 AND C3P201D_3 = 1) OR (C3P201E_3 IS NOT NULL AND C3P201E_3 NOT IN (1,2,3,4,19) AND C3P201F_3 = 1)) THEN 1 ELSE 0 END AS `C3P201_3_1`,
    CASE WHEN SEXO IN (1,2) AND C3P201_4 = 1 AND C3P203 = 1 AND (C3P201A_4 IN (1,2,3,4,19) OR C3P201E_4 IN (1,2,3,4,19) OR (C3P201A_4 IS NOT NULL AND C3P201A_4 NOT IN (1,2,3,4,19) AND C3P201C_4 = 1 AND C3P201D_4 = 1) OR (C3P201E_4 IS NOT NULL AND C3P201E_4 NOT IN (1,2,3,4,19) AND C3P201F_4 = 1)) THEN 1 ELSE 0 END AS `C3P201_4_1`,
    CASE WHEN SEXO IN (1,2) AND C3P201_5 = 1 AND C3P203 = 1 AND (C3P201A_5 IN (1,2,3,4,19) OR C3P201E_5 IN (1,2,3,4,19) OR (C3P201A_5 IS NOT NULL AND C3P201A_5 NOT IN (1,2,3,4,19) AND C3P201C_5 = 1 AND C3P201D_5 = 1) OR (C3P201E_5 IS NOT NULL AND C3P201E_5 NOT IN (1,2,3,4,19) AND C3P201F_5 = 1)) THEN 1 ELSE 0 END AS `C3P201_5_1`,
    CASE WHEN SEXO IN (1,2) AND C3P201_6 = 1 AND C3P203 = 1 AND (C3P201A_6 IN (1,2,3,4,19) OR C3P201E_6 IN (1,2,3,4,19) OR (C3P201A_6 IS NOT NULL AND C3P201A_6 NOT IN (1,2,3,4,19) AND C3P201C_6 = 1 AND C3P201D_6 = 1) OR (C3P201E_6 IS NOT NULL AND C3P201E_6 NOT IN (1,2,3,4,19) AND C3P201F_6 = 1)) THEN 1 ELSE 0 END AS `C3P201_6_1`,
    CASE WHEN SEXO IN (1,2) AND C3P201_7 = 1 AND C3P203 = 1 AND (C3P201A_7 IN (1,2,3,4,19) OR C3P201E_7 IN (1,2,3,4,19) OR (C3P201A_7 IS NOT NULL AND C3P201A_7 NOT IN (1,2,3,4,19) AND C3P201C_7 = 1 AND C3P201D_7 = 1) OR (C3P201E_7 IS NOT NULL AND C3P201E_7 NOT IN (1,2,3,4,19) AND C3P201F_7 = 1)) THEN 1 ELSE 0 END AS `C3P201_7_1`,
    CASE WHEN SEXO IN (1,2) AND C3P201_8 = 1 AND C3P203 = 1 AND (C3P201A_8 IN (1,2,3,4,19) OR C3P201E_8 IN (1,2,3,4,19) OR (C3P201A_8 IS NOT NULL AND C3P201A_8 NOT IN (1,2,3,4,19) AND C3P201C_8 = 1 AND C3P201D_8 = 1) OR (C3P201E_8 IS NOT NULL AND C3P201E_8 NOT IN (1,2,3,4,19) AND C3P201F_8 = 1)) THEN 1 ELSE 0 END AS `C3P201_8_1`,
    CASE WHEN SEXO IN (1,2) AND C3P201_9 = 1 AND C3P203 = 1 AND (C3P201A_9 IN (1,2,3,4,19) OR C3P201E_9 IN (1,2,3,4,19) OR (C3P201A_9 IS NOT NULL AND C3P201A_9 NOT IN (1,2,3,4,19) AND C3P201C_9 = 1 AND C3P201D_9 = 1) OR (C3P201E_9 IS NOT NULL AND C3P201E_9 NOT IN (1,2,3,4,19) AND C3P201F_9 = 1)) THEN 1 ELSE 0 END AS `C3P201_9_1`,
    CASE WHEN SEXO IN (1,2) AND C3P201_10 = 1 AND C3P203 = 1 AND (C3P201A_10 IN (1,2,3,4,19) OR C3P201E_10 IN (1,2,3,4,19) OR (C3P201A_10 IS NOT NULL AND C3P201A_10 NOT IN (1,2,3,4,19) AND C3P201C_10 = 1 AND C3P201D_10 = 1) OR (C3P201E_10 IS NOT NULL AND C3P201E_10 NOT IN (1,2,3,4,19) AND C3P201F_10 = 1)) THEN 1 ELSE 0 END AS `C3P201_10_1`,
    CASE WHEN SEXO IN (1,2) AND C3P201_11 = 1 AND C3P203 = 1 AND (C3P201A_11 IN (1,2,3,4,19) OR C3P201E_11 IN (1,2,3,4,19) OR (C3P201A_11 IS NOT NULL AND C3P201A_11 NOT IN (1,2,3,4,19) AND C3P201C_11 = 1 AND C3P201D_11 = 1) OR (C3P201E_11 IS NOT NULL AND C3P201E_11 NOT IN (1,2,3,4,19) AND C3P201F_11 = 1)) THEN 1 ELSE 0 END AS `C3P201_11_1`,
    CASE WHEN SEXO IN (1,2) AND C3P205_1 = 1 AND C3P207 = 1 AND (C3P205A_1 IN (1,2,3,4,19) OR C3P205E_1 IN (1,2,3,4,19) OR (C3P205A_1 IS NOT NULL AND C3P205A_1 NOT IN (1,2,3,4,19) AND C3P205C_1 = 1 AND C3P205D_1 = 1) OR (C3P205E_1 IS NOT NULL AND C3P205E_1 NOT IN (1,2,3,4,19) AND C3P205F_1 = 1)) THEN 1 ELSE 0 END AS `C3P205_1_1`,
    CASE WHEN SEXO IN (1,2) AND C3P205_2 = 1 AND C3P207 = 1 AND (C3P205A_2 IN (1,2,3,4,19) OR C3P205E_2 IN (1,2,3,4,19) OR (C3P205A_2 IS NOT NULL AND C3P205A_2 NOT IN (1,2,3,4,19) AND C3P205C_2 = 1 AND C3P205D_2 = 1) OR (C3P205E_2 IS NOT NULL AND C3P205E_2 NOT IN (1,2,3,4,19) AND C3P205F_2 = 1)) THEN 1 ELSE 0 END AS `C3P205_2_1`,
    CASE WHEN SEXO IN (1,2) AND C3P205_3 = 1 AND C3P207 = 1 AND (C3P205A_3 IN (1,2,3,4,19) OR C3P205E_3 IN (1,2,3,4,19) OR (C3P205A_3 IS NOT NULL AND C3P205A_3 NOT IN (1,2,3,4,19) AND C3P205C_3 = 1 AND C3P205D_3 = 1) OR (C3P205E_3 IS NOT NULL AND C3P205E_3 NOT IN (1,2,3,4,19) AND C3P205F_3 = 1)) THEN 1 ELSE 0 END AS `C3P205_3_1`,
    CASE WHEN SEXO IN (1,2) AND C3P205_4 = 1 AND C3P207 = 1 AND (C3P205A_4 IN (1,2,3,4,19) OR C3P205E_4 IN (1,2,3,4,19) OR (C3P205A_4 IS NOT NULL AND C3P205A_4 NOT IN (1,2,3,4,19) AND C3P205C_4 = 1 AND C3P205D_4 = 1) OR (C3P205E_4 IS NOT NULL AND C3P205E_4 NOT IN (1,2,3,4,19) AND C3P205F_4 = 1)) THEN 1 ELSE 0 END AS `C3P205_4_1`,
    CASE WHEN SEXO IN (1,2) AND C3P205_5 = 1 AND C3P207 = 1 AND (C3P205A_5 IN (1,2,3,4,19) OR C3P205E_5 IN (1,2,3,4,19) OR (C3P205A_5 IS NOT NULL AND C3P205A_5 NOT IN (1,2,3,4,19) AND C3P205C_5 = 1 AND C3P205D_5 = 1) OR (C3P205E_5 IS NOT NULL AND C3P205E_5 NOT IN (1,2,3,4,19) AND C3P205F_5 = 1)) THEN 1 ELSE 0 END AS `C3P205_5_1`,
    CASE WHEN SEXO IN (1,2) AND C3P205_6 = 1 AND C3P207 = 1 AND (C3P205A_6 IN (1,2,3,4,19) OR C3P205E_6 IN (1,2,3,4,19) OR (C3P205A_6 IS NOT NULL AND C3P205A_6 NOT IN (1,2,3,4,19) AND C3P205C_6 = 1 AND C3P205D_6 = 1) OR (C3P205E_6 IS NOT NULL AND C3P205E_6 NOT IN (1,2,3,4,19) AND C3P205F_6 = 1)) THEN 1 ELSE 0 END AS `C3P205_6_1`,
    CASE WHEN SEXO IN (1,2) AND C3P205_7 = 1 AND C3P207 = 1 AND (C3P205A_7 IN (1,2,3,4,19) OR C3P205E_7 IN (1,2,3,4,19) OR (C3P205A_7 IS NOT NULL AND C3P205A_7 NOT IN (1,2,3,4,19) AND C3P205C_7 = 1 AND C3P205D_7 = 1) OR (C3P205E_7 IS NOT NULL AND C3P205E_7 NOT IN (1,2,3,4,19) AND C3P205F_7 = 1)) THEN 1 ELSE 0 END AS `C3P205_7_1`
  FROM base
),

block_02_32_hogar_principales AS (
  SELECT
    *,
    CASE WHEN (`C3P201_1_1` = 1 OR `C3P201_2_1` = 1 OR `C3P201_3_1` = 1 OR `C3P201_4_1` = 1 OR `C3P201_5_1` = 1 OR `C3P201_6_1` = 1 OR `C3P201_7_1` = 1 OR `C3P201_8_1` = 1 OR `C3P201_9_1` = 1 OR `C3P201_10_1` = 1 OR `C3P201_11_1` = 1) THEN 1 ELSE 0 END AS `VP_HOGAR`,
    CASE WHEN (`C3P205_1_1` = 1 OR `C3P205_2_1` = 1 OR `C3P205_3_1` = 1 OR `C3P205_4_1` = 1 OR `C3P205_5_1` = 1 OR `C3P205_6_1` = 1 OR `C3P205_7_1` = 1) THEN 1 ELSE 0 END AS `VF_HOGAR`,
    CASE WHEN C3P121 = 1 THEN 1 ELSE 0 END AS `VF_HOGAR_01`,
    CASE WHEN ((C3P216A_1 = 1 AND C3P216A_1C = 1) OR (C3P216A_2 = 1 AND C3P216A_2C = 1) OR (C3P216A_3 = 1 AND C3P216A_3C = 1) OR (C3P216A_4 = 1 AND C3P216A_4C = 1) OR (C3P216A_5 = 1 AND C3P216A_5C = 1) OR (C3P216A_6 = 1 AND C3P216A_6C = 1)) OR ((C3P216C_1 = 1 AND C3P216C_1C = 1) OR (C3P216C_2 = 1 AND C3P216C_2C = 1) OR (C3P216C_3 = 1 AND C3P216C_3C = 1) OR (C3P216C_4 = 1 AND C3P216C_4C = 1) OR (C3P216C_5 = 1 AND C3P216C_5C = 1)) THEN 1 ELSE 0 END AS `VF_HOGAR_03`
  FROM block_01_32_hogar_formas
),

block_03_32_hogar_combinaciones_base AS (
  SELECT
    *,
    CASE WHEN VF_HOGAR_01 = 1 OR VF_HOGAR_03 = 1 THEN 1 ELSE 0 END AS `VN_HOGAR1`,
    CASE WHEN VP_HOGAR = 1 OR VF_HOGAR = 1 OR VF_HOGAR_01 = 1 OR VF_HOGAR_03 = 1 THEN 1 ELSE 0 END AS `INDICADOR_8_3_6`,
    CASE WHEN VP_HOGAR = 1 OR VF_HOGAR = 1 THEN 1 ELSE 0 END AS `VP_o_VF_HOGAR`,
    CASE WHEN VP_HOGAR = 1 AND VF_HOGAR = 1 THEN 1 ELSE 0 END AS `VP_VF_HOGAR`
  FROM block_02_32_hogar_principales
),

block_04_32_hogar_aliases_publicados AS (
  SELECT
    *,
    VP_VF_HOGAR AS `Solap_VP_VF_H__Coexistencia`
  FROM block_03_32_hogar_combinaciones_base
),

block_05_32_hogar_icvac AS (
  SELECT
    *,
    CASE WHEN (`C3P201_6_1` = 1 OR `C3P201_7_1` = 1 OR `C3P201_9_1` = 1) THEN 1 ELSE 0 END AS `VP_ICVAC_401_ATERRORIZAR`,
    CASE WHEN (`C3P201_1_1` = 1 OR `C3P201_2_1` = 1 OR `C3P201_3_1` = 1 OR `C3P201_4_1` = 1 OR `C3P201_5_1` = 1) THEN 1 ELSE 0 END AS `VP_ICVAC_402_HOSTIGAR_HUMILLAR`,
    CASE WHEN (`C3P201_8_1` = 1 OR `C3P201_10_1` = 1) THEN 1 ELSE 0 END AS `VP_ICVAC_203_AISLAMIENTO`,
    CASE WHEN C3P201_11_1 = 1 THEN 1 ELSE 0 END AS `VP_ICVAC_409_OTROS`,
    CASE WHEN (`C3P205_5_1` = 1 OR `C3P205_6_1` = 1) THEN 1 ELSE 0 END AS `VF_ICVAC_201_AGRESION_GRAVE`,
    CASE WHEN (`C3P205_1_1` = 1 OR `C3P205_2_1` = 1 OR `C3P205_3_1` = 1 OR `C3P205_4_1` = 1) THEN 1 ELSE 0 END AS `VF_ICVAC_202_AGRESION_LEVE`,
    CASE WHEN C3P205_7_1 = 1 THEN 1 ELSE 0 END AS `VF_ICVAC_209_OTROS`
  FROM block_04_32_hogar_aliases_publicados
),

block_06_321_hogar_agresores AS (
  SELECT
    *,
    CASE WHEN (C3P201_1 = 1 AND C3P203 = 1 AND (C3P201A_1 IN (1) OR C3P201E_1 IN (1))) OR (C3P201_2 = 1 AND C3P203 = 1 AND (C3P201A_2 IN (1) OR C3P201E_2 IN (1))) OR (C3P201_3 = 1 AND C3P203 = 1 AND (C3P201A_3 IN (1) OR C3P201E_3 IN (1))) OR (C3P201_4 = 1 AND C3P203 = 1 AND (C3P201A_4 IN (1) OR C3P201E_4 IN (1))) OR (C3P201_5 = 1 AND C3P203 = 1 AND (C3P201A_5 IN (1) OR C3P201E_5 IN (1))) OR (C3P201_6 = 1 AND C3P203 = 1 AND (C3P201A_6 IN (1) OR C3P201E_6 IN (1))) OR (C3P201_7 = 1 AND C3P203 = 1 AND (C3P201A_7 IN (1) OR C3P201E_7 IN (1))) OR (C3P201_8 = 1 AND C3P203 = 1 AND (C3P201A_8 IN (1) OR C3P201E_8 IN (1))) OR (C3P201_9 = 1 AND C3P203 = 1 AND (C3P201A_9 IN (1) OR C3P201E_9 IN (1))) OR (C3P201_10 = 1 AND C3P203 = 1 AND (C3P201A_10 IN (1) OR C3P201E_10 IN (1))) OR (C3P201_11 = 1 AND C3P203 = 1 AND (C3P201A_11 IN (1) OR C3P201E_11 IN (1))) THEN 1 ELSE 0 END AS `AG_VP_H_01`,
