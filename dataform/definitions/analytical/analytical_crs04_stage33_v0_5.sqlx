    CASE WHEN (`C3P223_12_1` = 1 OR `C3P223_13_1` = 1) THEN 1 ELSE 0 END AS `VPE_ICVAC_401_ATERRORIZAR`,
    CASE WHEN (`C3P223_1_1` = 1 OR `C3P223_2_1` = 1 OR `C3P223_3_1` = 1 OR `C3P223_4_1` = 1 OR `C3P223_5_1` = 1 OR `C3P223_6_1` = 1 OR `C3P223_7_1` = 1 OR `C3P223_8_1` = 1 OR `C3P223_9_1` = 1 OR `C3P223_10_1` = 1) THEN 1 ELSE 0 END AS `VPE_ICVAC_402_HOSTIGAR_HUMILLAR`,
