    CASE WHEN C3P223_14_1 = 1 THEN 1 ELSE 0 END AS `VPE_ICVAC_409_OTROS`,
    CASE WHEN (`C3P227_5_1` = 1 OR `C3P227_7_1` = 1 OR `C3P227_8_1` = 1 OR `C3P227_9_1` = 1) THEN 1 ELSE 0 END AS `VFE_ICVAC_201_AGRESION_GRAVE`,
