config {
  type: "assertion",
  schema: "enares2024_crs04_ops",
  tags: ["stage03", "analytical", "stage32", "quality"]
}

WITH
candidate AS (
  SELECT *
  FROM ${ref("analytical_crs04_stage32_v0_5")}
),

duplicate_keys AS (
  SELECT ID, COLEGIAL_ID
  FROM candidate
  GROUP BY ID, COLEGIAL_ID
  HAVING COUNT(*) > 1
),

checks AS (
  SELECT "row_count" AS check_name, ABS(COUNT(*) - 18807) AS violation_count
  FROM candidate
  HAVING COUNT(*) != 18807

  UNION ALL

  SELECT "null_keys", COUNTIF(ID IS NULL OR COLEGIAL_ID IS NULL)
  FROM candidate
  HAVING COUNTIF(ID IS NULL OR COLEGIAL_ID IS NULL) > 0

  UNION ALL

  SELECT "duplicate_key_groups", COUNT(*)
  FROM duplicate_keys
  HAVING COUNT(*) > 0

  UNION ALL

  SELECT "survey_design_fields", COUNTIF(
    FACTOR_ALUMNOS IS NULL OR FACTOR_ALUMNOS <= 0
    OR CCDD IS NULL OR SEXO IS NULL OR AREA IS NULL
  )
  FROM candidate
  HAVING COUNTIF(
    FACTOR_ALUMNOS IS NULL OR FACTOR_ALUMNOS <= 0
    OR CCDD IS NULL OR SEXO IS NULL OR AREA IS NULL
  ) > 0

  UNION ALL

  SELECT "binary_outputs", COUNTIF(
    `C3P201_1_1` NOT IN (0, 1) OR `C3P201_1_1` IS NULL
    OR `C3P201_2_1` NOT IN (0, 1) OR `C3P201_2_1` IS NULL
    OR `C3P201_3_1` NOT IN (0, 1) OR `C3P201_3_1` IS NULL
    OR `C3P201_4_1` NOT IN (0, 1) OR `C3P201_4_1` IS NULL
    OR `C3P201_5_1` NOT IN (0, 1) OR `C3P201_5_1` IS NULL
    OR `C3P201_6_1` NOT IN (0, 1) OR `C3P201_6_1` IS NULL
    OR `C3P201_7_1` NOT IN (0, 1) OR `C3P201_7_1` IS NULL
    OR `C3P201_8_1` NOT IN (0, 1) OR `C3P201_8_1` IS NULL
    OR `C3P201_9_1` NOT IN (0, 1) OR `C3P201_9_1` IS NULL
    OR `C3P201_10_1` NOT IN (0, 1) OR `C3P201_10_1` IS NULL
    OR `C3P201_11_1` NOT IN (0, 1) OR `C3P201_11_1` IS NULL
    OR `C3P205_1_1` NOT IN (0, 1) OR `C3P205_1_1` IS NULL
    OR `C3P205_2_1` NOT IN (0, 1) OR `C3P205_2_1` IS NULL
    OR `C3P205_3_1` NOT IN (0, 1) OR `C3P205_3_1` IS NULL
    OR `C3P205_4_1` NOT IN (0, 1) OR `C3P205_4_1` IS NULL
    OR `C3P205_5_1` NOT IN (0, 1) OR `C3P205_5_1` IS NULL
    OR `C3P205_6_1` NOT IN (0, 1) OR `C3P205_6_1` IS NULL
    OR `C3P205_7_1` NOT IN (0, 1) OR `C3P205_7_1` IS NULL
    OR `VP_HOGAR` NOT IN (0, 1) OR `VP_HOGAR` IS NULL
    OR `VF_HOGAR` NOT IN (0, 1) OR `VF_HOGAR` IS NULL
    OR `VF_HOGAR_01` NOT IN (0, 1) OR `VF_HOGAR_01` IS NULL
    OR `VF_HOGAR_03` NOT IN (0, 1) OR `VF_HOGAR_03` IS NULL
    OR `VN_HOGAR1` NOT IN (0, 1) OR `VN_HOGAR1` IS NULL
    OR `INDICADOR_8_3_6` NOT IN (0, 1) OR `INDICADOR_8_3_6` IS NULL
    OR `VP_o_VF_HOGAR` NOT IN (0, 1) OR `VP_o_VF_HOGAR` IS NULL
    OR `VP_VF_HOGAR` NOT IN (0, 1) OR `VP_VF_HOGAR` IS NULL
    OR `Solap_VP_VF_H__Coexistencia` NOT IN (0, 1) OR `Solap_VP_VF_H__Coexistencia` IS NULL
    OR `VP_ICVAC_401_ATERRORIZAR` NOT IN (0, 1) OR `VP_ICVAC_401_ATERRORIZAR` IS NULL
    OR `VP_ICVAC_402_HOSTIGAR_HUMILLAR` NOT IN (0, 1) OR `VP_ICVAC_402_HOSTIGAR_HUMILLAR` IS NULL
    OR `VP_ICVAC_203_AISLAMIENTO` NOT IN (0, 1) OR `VP_ICVAC_203_AISLAMIENTO` IS NULL
    OR `VP_ICVAC_409_OTROS` NOT IN (0, 1) OR `VP_ICVAC_409_OTROS` IS NULL
    OR `VF_ICVAC_201_AGRESION_GRAVE` NOT IN (0, 1) OR `VF_ICVAC_201_AGRESION_GRAVE` IS NULL
    OR `VF_ICVAC_202_AGRESION_LEVE` NOT IN (0, 1) OR `VF_ICVAC_202_AGRESION_LEVE` IS NULL
    OR `VF_ICVAC_209_OTROS` NOT IN (0, 1) OR `VF_ICVAC_209_OTROS` IS NULL
    OR `AG_VP_H_01` NOT IN (0, 1) OR `AG_VP_H_01` IS NULL
    OR `AG_VP_H_02` NOT IN (0, 1) OR `AG_VP_H_02` IS NULL
    OR `AG_VP_H_03` NOT IN (0, 1) OR `AG_VP_H_03` IS NULL
    OR `AG_VP_H_04` NOT IN (0, 1) OR `AG_VP_H_04` IS NULL
    OR `AG_VP_H_05` NOT IN (0, 1) OR `AG_VP_H_05` IS NULL
    OR `AG_VP_H_06` NOT IN (0, 1) OR `AG_VP_H_06` IS NULL
    OR `AG_VP_H_07` NOT IN (0, 1) OR `AG_VP_H_07` IS NULL
    OR `AG_VP_H_08` NOT IN (0, 1) OR `AG_VP_H_08` IS NULL
    OR `AG_VF_H_01` NOT IN (0, 1) OR `AG_VF_H_01` IS NULL
    OR `AG_VF_H_02` NOT IN (0, 1) OR `AG_VF_H_02` IS NULL
    OR `AG_VF_H_03` NOT IN (0, 1) OR `AG_VF_H_03` IS NULL
    OR `AG_VF_H_04` NOT IN (0, 1) OR `AG_VF_H_04` IS NULL
    OR `AG_VF_H_05` NOT IN (0, 1) OR `AG_VF_H_05` IS NULL
    OR `AG_VF_H_06` NOT IN (0, 1) OR `AG_VF_H_06` IS NULL
    OR `AG_VF_H_07` NOT IN (0, 1) OR `AG_VF_H_07` IS NULL
    OR `AG_VF_H_08` NOT IN (0, 1) OR `AG_VF_H_08` IS NULL
  )
  FROM candidate
  HAVING COUNTIF(
    `C3P201_1_1` NOT IN (0, 1) OR `C3P201_1_1` IS NULL
    OR `C3P201_2_1` NOT IN (0, 1) OR `C3P201_2_1` IS NULL
    OR `C3P201_3_1` NOT IN (0, 1) OR `C3P201_3_1` IS NULL
    OR `C3P201_4_1` NOT IN (0, 1) OR `C3P201_4_1` IS NULL
    OR `C3P201_5_1` NOT IN (0, 1) OR `C3P201_5_1` IS NULL
    OR `C3P201_6_1` NOT IN (0, 1) OR `C3P201_6_1` IS NULL
    OR `C3P201_7_1` NOT IN (0, 1) OR `C3P201_7_1` IS NULL
    OR `C3P201_8_1` NOT IN (0, 1) OR `C3P201_8_1` IS NULL
    OR `C3P201_9_1` NOT IN (0, 1) OR `C3P201_9_1` IS NULL
    OR `C3P201_10_1` NOT IN (0, 1) OR `C3P201_10_1` IS NULL
    OR `C3P201_11_1` NOT IN (0, 1) OR `C3P201_11_1` IS NULL
    OR `C3P205_1_1` NOT IN (0, 1) OR `C3P205_1_1` IS NULL
    OR `C3P205_2_1` NOT IN (0, 1) OR `C3P205_2_1` IS NULL
    OR `C3P205_3_1` NOT IN (0, 1) OR `C3P205_3_1` IS NULL
    OR `C3P205_4_1` NOT IN (0, 1) OR `C3P205_4_1` IS NULL
    OR `C3P205_5_1` NOT IN (0, 1) OR `C3P205_5_1` IS NULL
    OR `C3P205_6_1` NOT IN (0, 1) OR `C3P205_6_1` IS NULL
    OR `C3P205_7_1` NOT IN (0, 1) OR `C3P205_7_1` IS NULL
    OR `VP_HOGAR` NOT IN (0, 1) OR `VP_HOGAR` IS NULL
    OR `VF_HOGAR` NOT IN (0, 1) OR `VF_HOGAR` IS NULL
    OR `VF_HOGAR_01` NOT IN (0, 1) OR `VF_HOGAR_01` IS NULL
    OR `VF_HOGAR_03` NOT IN (0, 1) OR `VF_HOGAR_03` IS NULL
    OR `VN_HOGAR1` NOT IN (0, 1) OR `VN_HOGAR1` IS NULL
    OR `INDICADOR_8_3_6` NOT IN (0, 1) OR `INDICADOR_8_3_6` IS NULL
    OR `VP_o_VF_HOGAR` NOT IN (0, 1) OR `VP_o_VF_HOGAR` IS NULL
    OR `VP_VF_HOGAR` NOT IN (0, 1) OR `VP_VF_HOGAR` IS NULL
    OR `Solap_VP_VF_H__Coexistencia` NOT IN (0, 1) OR `Solap_VP_VF_H__Coexistencia` IS NULL
    OR `VP_ICVAC_401_ATERRORIZAR` NOT IN (0, 1) OR `VP_ICVAC_401_ATERRORIZAR` IS NULL
    OR `VP_ICVAC_402_HOSTIGAR_HUMILLAR` NOT IN (0, 1) OR `VP_ICVAC_402_HOSTIGAR_HUMILLAR` IS NULL
    OR `VP_ICVAC_203_AISLAMIENTO` NOT IN (0, 1) OR `VP_ICVAC_203_AISLAMIENTO` IS NULL
    OR `VP_ICVAC_409_OTROS` NOT IN (0, 1) OR `VP_ICVAC_409_OTROS` IS NULL
    OR `VF_ICVAC_201_AGRESION_GRAVE` NOT IN (0, 1) OR `VF_ICVAC_201_AGRESION_GRAVE` IS NULL
    OR `VF_ICVAC_202_AGRESION_LEVE` NOT IN (0, 1) OR `VF_ICVAC_202_AGRESION_LEVE` IS NULL
    OR `VF_ICVAC_209_OTROS` NOT IN (0, 1) OR `VF_ICVAC_209_OTROS` IS NULL
    OR `AG_VP_H_01` NOT IN (0, 1) OR `AG_VP_H_01` IS NULL
    OR `AG_VP_H_02` NOT IN (0, 1) OR `AG_VP_H_02` IS NULL
    OR `AG_VP_H_03` NOT IN (0, 1) OR `AG_VP_H_03` IS NULL
    OR `AG_VP_H_04` NOT IN (0, 1) OR `AG_VP_H_04` IS NULL
    OR `AG_VP_H_05` NOT IN (0, 1) OR `AG_VP_H_05` IS NULL
    OR `AG_VP_H_06` NOT IN (0, 1) OR `AG_VP_H_06` IS NULL
    OR `AG_VP_H_07` NOT IN (0, 1) OR `AG_VP_H_07` IS NULL
