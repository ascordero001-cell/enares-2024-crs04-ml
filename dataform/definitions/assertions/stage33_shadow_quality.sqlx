    OR `C3P227_10_1` NOT IN (0, 1) OR `C3P227_10_1` IS NULL
    OR `VP_ESCUELA` NOT IN (0, 1) OR `VP_ESCUELA` IS NULL
    OR `VF_ESCUELA` NOT IN (0, 1) OR `VF_ESCUELA` IS NULL
    OR `VPE_ICVAC_401_ATERRORIZAR` NOT IN (0, 1) OR `VPE_ICVAC_401_ATERRORIZAR` IS NULL
    OR `VPE_ICVAC_402_HOSTIGAR_HUMILLAR` NOT IN (0, 1) OR `VPE_ICVAC_402_HOSTIGAR_HUMILLAR` IS NULL
    OR `VPE_ICVAC_203_AISLAMIENTO` NOT IN (0, 1) OR `VPE_ICVAC_203_AISLAMIENTO` IS NULL
    OR `VPE_ICVAC_409_OTROS` NOT IN (0, 1) OR `VPE_ICVAC_409_OTROS` IS NULL
    OR `VFE_ICVAC_201_AGRESION_GRAVE` NOT IN (0, 1) OR `VFE_ICVAC_201_AGRESION_GRAVE` IS NULL
    OR `VFE_ICVAC_202_AGRESION_LEVE` NOT IN (0, 1) OR `VFE_ICVAC_202_AGRESION_LEVE` IS NULL
