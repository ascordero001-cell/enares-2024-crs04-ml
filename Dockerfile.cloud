FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    STAGE04_DATA_MODE=AUTHENTICATED_SHADOW

WORKDIR /app

COPY requirements-runtime.txt requirements-cloud-runtime.txt ./

RUN python -m pip install --no-cache-dir --disable-pip-version-check \
      -r requirements-cloud-runtime.txt \
    && addgroup --system app \
    && adduser --system --ingroup app app

COPY --chown=app:app app/streamlit_app.py ./app/streamlit_app.py
COPY --chown=app:app app/__init__.py app/repositories.py app/ui_redesign_app.py ./app/
COPY --chown=app:app app/config ./app/config
COPY --chown=app:app app/views ./app/views
COPY --chown=app:app .streamlit/config.toml ./.streamlit/config.toml
COPY --chown=app:app src ./src
COPY --chown=app:app scripts/container_healthcheck.py ./scripts/container_healthcheck.py
COPY --chown=app:app app/data/v0_authorized_full_indicator_estimates.manifest.json ./app/data/v0_authorized_full_indicator_estimates.manifest.json
COPY --chown=app:app docs/stage04/v0_drive_hash_manifest.md ./docs/stage04/v0_drive_hash_manifest.md

USER app

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
    CMD ["python", "scripts/container_healthcheck.py"]

CMD ["sh", "-c", "exec python -m streamlit run app/streamlit_app.py --server.address=0.0.0.0 --server.port=${PORT:-8080} --server.headless=true --browser.gatherUsageStats=false"]
